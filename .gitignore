# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Data & model artifacts — too large for git, and must never be committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
checkpoints/*.pt
checkpoints/*.pth
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep

# Jupyter
.ipynb_checkpoints/

# OS / editor junk
.DS_Store
.vscode/
*.swp

# Env secrets, if any ever get added
.env
